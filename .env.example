# Copy to .env and fill in. All have working defaults for local docker-compose.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rolematch:rolematch@localhost:5432/rolematch

# Embeddings (Sentence Transformers, runs locally, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM provider: "openai" or "mock"
# "mock" runs fully offline (no key) and is the default so the app boots without a key.
# "openai" works with OpenAI AND any OpenAI-compatible endpoint via OPENAI_BASE_URL.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible provider instead of OpenAI. Examples:
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1   (model e.g. llama-3.3-70b-versatile)
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1     (model e.g. meta-llama/llama-3.3-70b-instruct:free)
# Leave blank to use OpenAI's default endpoint.
OPENAI_BASE_URL=
