# Copy to .env and fill in. All have working defaults for local docker-compose.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rolematch:rolematch@localhost:5432/rolematch

# Embeddings (Sentence Transformers, runs locally, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM provider: "openai" or "mock"
# "mock" runs fully offline (no key) and is the default so the app boots without a key.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
